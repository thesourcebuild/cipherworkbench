  },
  "devDependencies": {
    "@ocs/config": "workspace:*",
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
