{
  "name": "@ocs/checkdigit",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "//": "Check digit algorithms: Luhn, Verhoeff, Damm, ISBN/EAN-13, IBAN, ABA routing, CUSIP/ISIN, and SEDOL. Operates on human-entered alphanumeric identifiers to detect single-digit typos and adjacent transpositions.",
  "exports": {
    ".": "./src/index.ts",
    "./pure": "./src/pure.ts",
    "./manifests": "./src/manifest.ts",
    "./definition": "./src/definition.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ocs/algos": "workspace:*",
    "@ocs/contracts": "workspace:*",
    "@ocs/engine": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ocs/config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
