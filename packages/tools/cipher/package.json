{
  "name": "@ocs/cipher",
  "version": "0.4.5",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "//": "Symmetric encryption and decryption. Five tools: AES (five modes behind one dropdown), ChaCha20-Poly1305, XChaCha20-Poly1305, raw ChaCha20, and RC4. The first family where `inverse` means decryption rather than verification.",
  "exports": {
    ".": "./src/index.ts",
    "./pure": "./src/pure.ts",
    "./manifests": "./src/manifest.ts",
    "./definition": "./src/definition.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.0",
    "@noble/hashes": "^2.2.0",
    "@ocs/algos": "workspace:*",
    "@ocs/contracts": "workspace:*",
    "@ocs/engine": "workspace:*",
    "@ocs/kdf": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ocs/config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
